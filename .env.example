NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare R2 Storage (server-side only - keep these secret!)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# R2 Public URL (safe to expose in frontend)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Site URL — used for Stripe redirects and metadata
NEXT_PUBLIC_SITE_URL=https://liveonwith.me

# Stripe (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin SDK (server-side only - get from Firebase console → Project Settings → Service Accounts)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Maps / Places API — used for cemetery lookup on the memorial edit page.
# Enable the "Places API" and "Maps JavaScript API" in the Google Cloud console, then create an API key.
# Restrict it by HTTP referrer to your domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
