rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function memorial(memorialId) {
      return firestore.get(/databases/(default)/documents/memorials/$(memorialId)).data;
    }
    // Owner OR co-manager — same edit rights for day-to-day media.
    function canEdit(memorialId) {
      let m = memorial(memorialId);
      return request.auth != null && (
        m.ownerId == request.auth.uid
        || request.auth.uid in m.get('coManagerUids', [])
      );
    }
    function visible(memorialId) {
      return memorial(memorialId).visibility in ['public', 'unlisted'];
    }
    function validImage() {
      return request.resource.size < 15 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /memorials/{memorialId}/{fileName} {
      allow read: if canEdit(memorialId) || visible(memorialId);
      allow create, update, delete: if canEdit(memorialId) && (request.resource == null || validImage());
    }

    match /contributions/{memorialId}/{fileName} {
      allow create: if validImage();
      allow read: if canEdit(memorialId) || visible(memorialId);
      allow update, delete: if canEdit(memorialId);
    }
  }
}
